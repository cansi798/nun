---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/site.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import MobilNav from "../components/MobilNav.astro";
import { ladeDaten } from "../lib/daten";
import { absolut, link } from "../lib/hilfen";
// Die drei Schnitte, die jede Seite oberhalb der Falz braucht, früh laden
import fontTitel from "../assets/fonts/cormorant-garamond-latin-500.woff2?url";
import fontText from "../assets/fonts/source-serif-4-latin-400.woff2?url";
import fontUi from "../assets/fonts/inter-latin-500.woff2?url";

interface Props { titel?: string; beschreibung?: string; aktiv?: string; noindex?: boolean; typ?: "website" | "article"; datum?: string }
const { titel = "", beschreibung, aktiv = "", noindex = false, typ = "website", datum } = Astro.props;
const d = await ladeDaten();
const voll = titel ? `${titel} · ${d.site.name}` : `${d.site.name} · ${d.site.leitsatz}`;
const lang = beschreibung || d.site.beschreibung;
// Beschreibung für Suchmaschinen auf etwa 155 Zeichen an einer Wortgrenze kürzen
const text = lang.length > 160 ? lang.slice(0, 155).replace(/\s+\S*$/, "") + " …" : lang;
const kanonisch = absolut(Astro.url.pathname.replace(import.meta.env.BASE_URL, ""));
---
<!doctype html>
<html lang="de" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{voll}</title>
{[fontTitel, fontText, fontUi].map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
<meta name="description" content={text}>
{noindex && <meta name="robots" content="noindex">}
{!noindex && <link rel="canonical" href={kanonisch}>}
<link rel="icon" href={link("favicon.ico")} sizes="48x48">
<link rel="icon" href={link("favicon.svg")} type="image/svg+xml" sizes="any">
<link rel="apple-touch-icon" href={link("apple-touch-icon.png")}>
<link rel="manifest" href={link("site.webmanifest")}>
<meta name="theme-color" content="#F5EFE2">
<meta property="og:type" content={typ}>
<meta property="og:site_name" content={d.site.name}>
{!noindex && <meta property="og:url" content={kanonisch}>}
{datum && <meta property="article:published_time" content={datum}>}
<meta name="twitter:card" content="summary_large_image">
<meta property="og:title" content={voll}>
<meta property="og:description" content={text}>
<meta property="og:image" content={absolut("og-image.png")}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="NUN · Damit wir einander kennen">
<meta name="twitter:image" content={absolut("og-image.png")}>
<meta property="og:locale" content="de_DE">
<script is:inline>try{var t=localStorage.getItem("nun-thema");if(t==="dark")document.documentElement.dataset.theme="dark"}catch(_){}</script>
<slot name="kopf" />
</head>
<body>
<a class="sprung" href="#inhalt">Zum Inhalt springen</a>
<SiteHeader aktiv={aktiv} />
<main id="inhalt">
<slot />
</main>
<SiteFooter />
<MobilNav aktiv={aktiv} />
</body>
</html>

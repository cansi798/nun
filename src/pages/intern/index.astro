---
// Interner Bereich. Mit PUBLIC_PB_URL speichert das Formular direkt in PocketBase,
// sonst erzeugt es die JSON-Datei für content/beitraege.
import Basis from "../../layouts/Basis.astro";
import Seitenkopf from "../../components/Seitenkopf.astro";
import UploadFeld from "../../components/UploadFeld.astro";
import { ladeDaten } from "../../lib/daten";
import { ausgabeText, autorName } from "../../lib/hilfen";
const d = await ladeDaten();
const pb = import.meta.env.PUBLIC_PB_URL ?? "";
---
<Basis titel="Beitrag einstellen" noindex>
  <div class="seite">
    <Seitenkopf titel="Beitrag einstellen" einleitung={pb
      ? "Interner Bereich für das Team. Nach der Anmeldung wird der Beitrag als Entwurf in der Datenbank gespeichert."
      : "Interner Bereich für das Team. Das Formular prüft das PDF und erzeugt die Datei für content/beitraege."} />
    <form class="formular schmal" data-einstellen data-pb={pb} novalidate>
      {pb && (
        <fieldset class="formular-gruppe" data-anmeldung>
          <legend class="t-h3">Anmeldung</legend>
          <label class="feld"><span class="feld-label">E-Mail</span><input name="email" type="email" autocomplete="username"></label>
          <label class="feld"><span class="feld-label">Passwort</span><input name="passwort" type="password" autocomplete="current-password"></label>
        </fieldset>
      )}
      <fieldset class="formular-gruppe">
        <legend class="t-h3">Datei</legend>
        <UploadFeld />
      </fieldset>
      <fieldset class="formular-gruppe">
        <legend class="t-h3">Angaben</legend>
        <div class="feld-paar">
          <label class="feld"><span class="feld-label">Format</span><select name="format" required>{d.site.formate.map((f) => <option value={f.slug}>{f.name}</option>)}</select></label>
          <label class="feld"><span class="feld-label">Rubrik</span><select name="rubrik" required>{d.site.rubriken.map((r) => <option value={r.slug}>{r.name}</option>)}</select></label>
        </div>
        <label class="feld"><span class="feld-label">Titel</span><input name="titel" required></label>
        <label class="feld"><span class="feld-label">Untertitel</span><input name="untertitel"></label>
        <label class="feld"><span class="feld-label">Reihe</span><input name="reihe" placeholder="etwa Ilm Kompakt · Islamisches Wissen in 30 Minuten"></label>
        <label class="feld"><span class="feld-label">Autorin oder Autor</span><select name="autoren" multiple required size="3">{[...d.autoren.values()].map((a) => <option value={a.slug}>{autorName(a)}</option>)}</select></label>
        <label class="feld"><span class="feld-label">Ausgabe</span><select name="ausgabe"><option value="">Ohne Heft (laufend)</option>{[...d.ausgaben.values()].map((a) => <option value={a.id}>{ausgabeText(a)}</option>)}</select></label>
        <div class="feld-paar">
          <label class="feld"><span class="feld-label">Erste Seite</span><input name="seite_von" type="number" min="1" inputmode="numeric"></label>
          <label class="feld"><span class="feld-label">Letzte Seite</span><input name="seite_bis" type="number" min="1" inputmode="numeric"></label>
        </div>
        <div class="feld-paar">
          <label class="feld"><span class="feld-label">Erscheinungsdatum</span><input name="datum" type="date" required></label>
          <label class="feld"><span class="feld-label">DOI, falls vergeben</span><input name="doi" placeholder="10.5281/zenodo.0000000" inputmode="url"></label>
        </div>
        <label class="feld"><span class="feld-label">Abstract auf Deutsch</span><textarea name="abstract_de" rows="5" required></textarea></label>
        <label class="feld"><span class="feld-label">Abstract auf Englisch</span><textarea name="abstract_en" rows="4"></textarea></label>
        <label class="feld"><span class="feld-label">Schlagworte, durch Komma getrennt, höchstens fünf</span><input name="schlagworte" required></label>
      </fieldset>
      <p class="formular-meldung" data-meldung role="status" hidden></p>
      <div class="knopf-zeile"><button class="knopf primaer" type="submit">{pb ? "Als Entwurf speichern" : "Datei erzeugen"}</button></div>
    </form>
  </div>
</Basis>
<script>
  const form = document.querySelector<HTMLFormElement>("[data-einstellen]");
  if (form) {
    const feld = form.querySelector<HTMLElement>("[data-upload]")!;
    const input = feld.querySelector<HTMLInputElement>("input[type=file]")!;
    const anzeige = form.querySelector<HTMLElement>("[data-upload-datei]")!;
    const meldung = form.querySelector<HTMLElement>("[data-meldung]")!;
    const pbUrl = form.dataset.pb;
    let datei: File | null = null;
    const melde = (t: string) => { meldung.textContent = t; meldung.hidden = false; };
    const nimm = (f?: File | null) => {
      if (!f) return;
      if (f.type !== "application/pdf") return melde("Bitte nur PDF-Dateien hochladen.");
      if (f.size > 50 * 1024 * 1024) return melde("Die Datei ist größer als 50 MB.");
      datei = f; meldung.hidden = true; anzeige.hidden = false;
      anzeige.textContent = `${f.name} · ${(f.size / 1048576).toFixed(1).replace(".", ",")} MB · bereit`;
    };
    ["dragenter", "dragover"].forEach((t) => feld.addEventListener(t, (e) => { e.preventDefault(); feld.classList.add("ueber"); }));
    ["dragleave", "drop"].forEach((t) => feld.addEventListener(t, (e) => { e.preventDefault(); feld.classList.remove("ueber"); }));
    feld.addEventListener("drop", (e) => nimm((e as DragEvent).dataTransfer?.files[0]));
    input.addEventListener("change", () => nimm(input.files?.[0]));
    const slug = (s: string) => s.toLowerCase().replace(/ä/g, "ae").replace(/ö/g, "oe").replace(/ü/g, "ue").replace(/ß/g, "ss")
      .replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 60);

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      const d = new FormData(form);
      const worte = String(d.get("schlagworte")).split(",").map((s) => s.trim()).filter(Boolean);
      if (worte.length > 5) return melde("Höchstens fünf Schlagworte.");
      const s = slug(String(d.get("titel")));
      const von = Number(d.get("seite_von")), bis = Number(d.get("seite_bis"));
      const daten = {
        slug: s, format: d.get("format"), rubrik: d.get("rubrik"), reihe: d.get("reihe") || undefined,
        titel: d.get("titel"), untertitel: d.get("untertitel"), autoren: d.getAll("autoren"),
        ausgabe: d.get("ausgabe"), seiten: von && bis ? [von, bis] : [], datum: d.get("datum"),
        doi: d.get("doi"), abstract_de: d.get("abstract_de"), abstract_en: d.get("abstract_en"),
        schlagworte: worte, pdf: datei ? `pdf/${s}.pdf` : "", version: 1, versionen: [], inhalt: [], literatur: [],
      };
      if (pbUrl) {
        try {
          const { default: PocketBase } = await import("pocketbase");
          const pb = new PocketBase(pbUrl);
          await pb.collection("_superusers").authWithPassword(String(d.get("email")), String(d.get("passwort")))
            .catch(() => pb.collection("redaktion").authWithPassword(String(d.get("email")), String(d.get("passwort"))));
          const autorIds = await Promise.all(daten.autoren.map(async (a) => (await pb.collection("autoren").getFirstListItem(`slug="${a}"`)).id));
          const fd = new FormData();
          for (const [k, v] of Object.entries({ ...daten, autoren: undefined, seiten: undefined, pdf: undefined, ausgabe: undefined })) {
            if (v === undefined || v === null) continue;
            fd.append(k, typeof v === "object" ? JSON.stringify(v) : String(v));
          }
          autorIds.forEach((id) => fd.append("autoren", id));
          if (von && bis) { fd.append("seite_von", String(von)); fd.append("seite_bis", String(bis)); }
          if (daten.ausgabe) fd.append("ausgabe", (await pb.collection("ausgaben").getFirstListItem(`kennung="${daten.ausgabe}"`)).id);
          if (datei) fd.append("pdf", datei);
          fd.append("veroeffentlicht", "false");
          await pb.collection("beitraege").create(fd);
          melde(`Gespeichert als Entwurf. Nach der Prüfung durch ein zweites Teammitglied wird „${daten.titel}“ veröffentlicht.`);
        } catch (err) {
          melde(`Speichern hat nicht geklappt. ${(err as Error).message}`);
        }
        return;
      }
      const blob = new Blob([JSON.stringify(daten, null, 2) + "\n"], { type: "application/json" });
      const a = Object.assign(document.createElement("a"), { href: URL.createObjectURL(blob), download: `${s}.json` });
      a.click(); URL.revokeObjectURL(a.href);
      melde(`Datei ${s}.json erstellt. Legen Sie sie in content/beitraege und das PDF als public/pdf/${s}.pdf ab.`);
    });
  }
</script>

---
import Basis from "../../../layouts/Basis.astro";
import Seitenkopf from "../../../components/Seitenkopf.astro";
import Kennzeile from "../../../components/Kennzeile.astro";
import { beitraegeIn, ladeDaten } from "../../../lib/daten";
import { ausgabeText, autorName, beitragPfad, link } from "../../../lib/hilfen";
import type { Ausgabe } from "../../../lib/typen";
export async function getStaticPaths() {
  return [...(await ladeDaten()).ausgaben.values()].map((a) => ({ params: { id: a.id }, props: { a } }));
}
const { a } = Astro.props as { a: Ausgabe };
const d = await ladeDaten();
const bs = beitraegeIn(d, a.id);
---
<Basis titel={`${a.titel} · Heft ${a.heft}`} aktiv="ausgaben/">
  <div class="seite">
    <Seitenkopf titel={a.titel} rubrik={ausgabeText(a)}>
      <p class="unterzeile">ISSN {d.site.issn}</p>
      {a.pdf && <div class="knopf-zeile"><a class="knopf primaer" href={link(a.pdf)} download>Gesamt-PDF herunterladen</a></div>}
    </Seitenkopf>
    <section class="schmal">
      <h2 class="t-h2">Inhaltsverzeichnis</h2>
      {bs.length ? (
        <ol class="toc">
          {bs.map((b) => (
            <li>
              <Kennzeile b={b} lesezeit={false} />
              <a class="t-h3 toc-titel" href={link(beitragPfad(b))}>{b.titel}</a>
              <p class="unterzeile">{b.autoren.map((s) => autorName(d.autoren.get(s)!)).join(", ")}{b.seiten?.length ? ` · S. ${b.seiten[0]}–${b.seiten[1]}` : ""}</p>
            </li>
          ))}
        </ol>
      ) : <p class="leer">Dieses Heft ist in Vorbereitung. Fertige Beiträge erscheinen vorab online und werden dem Heft zugeordnet.</p>}
    </section>
  </div>
</Basis>

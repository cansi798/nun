---
import Basis from "../../layouts/Basis.astro";
import Seitenkopf from "../../components/Seitenkopf.astro";
import { ladeDaten } from "../../lib/daten";
import { anzahl, link } from "../../lib/hilfen";
const d = await ladeDaten();
---
<Basis titel="Themen" aktiv="themen/">
  <div class="seite">
    <Seitenkopf titel="Themen" einleitung="Die Rubriken folgen den Fächern des Studienplans. Jeder Beitrag hat genau eine Rubrik und bis zu fünf Schlagworte." />
    <div class="themen-gitter">
      {d.site.rubriken.map((r) => {
        const n = d.beitraege.filter((b) => b.rubrik === r.slug).length;
        const Tag = n ? "a" : "div";
        return (
          <Tag class:list={["thema-zelle", { "thema-leer": !n }]} href={n ? link(`publikationen/?rubrik=${r.slug}`) : undefined}>
            <span class="thema-name">{r.name}</span>
            <span class="thema-faecher">{r.faecher}</span>
            {n > 0 ? <span class="meta gold">{anzahl(n, "Beitrag", "Beiträge")}</span> : <span class="meta">In Vorbereitung</span>}
          </Tag>
        );
      })}
    </div>
  </div>
</Basis>

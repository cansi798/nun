---
import Basis from "../../layouts/Basis.astro";
import Seitenkopf from "../../components/Seitenkopf.astro";
import { ladeDaten } from "../../lib/daten";
const d = await ladeDaten();
const punkte = [
  ["Zugang", "Frei lesbar und herunterladbar, ohne Anmeldung."],
  ["Lizenz", `Creative Commons Namensnennung 4.0 (${d.site.lizenz.name}). Jeder darf teilen und weiterverwenden, wenn NUN und die Autoren genannt werden.`],
  ["Kennung", "Jeder Beitrag erhält eine DOI über Zenodo."],
  ["ISSN", `Die Zeitschrift trägt die ISSN ${d.site.issn}.`],
  ["Archivierung", "Die PDFs werden an die Deutsche Nationalbibliothek abgeliefert. Eine Kopie liegt zusätzlich auf Zenodo."],
  ["Auffindbarkeit", "Jede Artikelseite enthält Metadaten für Google Scholar und Schema.org."],
  ["Versionen", "Ein veröffentlichter Beitrag wird nicht mehr still geändert. Korrekturen erscheinen als neue Version mit Datum und Hinweis."],
  ["Prüfung", "Jeder Beitrag wird vor der Veröffentlichung von einem zweiten Mitglied des Teams gelesen."],
];
---
<Basis titel="Open Access">
  <div class="seite">
    <Seitenkopf titel="Open Access" einleitung="Alle Beiträge auf NUN sind frei zugänglich, ohne Bezahlschranke und ohne Gebühren für die Autorinnen und Autoren." />
    <div class="schmal">
      <dl class="tabelle-dl">{punkte.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      <h2 class="t-h2 abstand-oben">Formen</h2>
      <dl class="tabelle-dl">{d.site.formate.map((f) => <div><dt>{f.name}</dt><dd>{f.beschreibung}</dd></div>)}</dl>
      <h2 class="t-h2 abstand-oben">Wissenschaftliche Arten</h2>
      <dl class="tabelle-dl">{d.site.arten.map((a) => <div><dt>{a.name}</dt><dd>{a.umfang}</dd></div>)}</dl>
      <h2 class="t-h2 abstand-oben">Zitieren</h2>
      <p>Zitiert wird nach APA 7. Jede Artikelseite zeigt einen fertigen Zitiervorschlag und bietet ihn als BibTeX und RIS für Zotero und Citavi an.</p>
    </div>
  </div>
</Basis>

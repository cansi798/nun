---
import Basis from "../../layouts/Basis.astro";
import Seitenkopf from "../../components/Seitenkopf.astro";
---
<Basis titel="Impressum">
  <div class="seite">
    <Seitenkopf titel="Impressum" />
    <div class="schmal fliesstext">
      <p class="hinweis meta">Vorlage. Die Angaben in eckigen Klammern vor dem Start ergänzen und rechtlich prüfen lassen.</p>
      <p>Angaben nach § 5 DDG</p>
      <p>[Name des Vereins oder der verantwortlichen Person]<br>[Straße und Hausnummer]<br>[PLZ und Ort]</p>
      <p>E-Mail [Adresse]</p>
      <p>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV [Name und Anschrift]</p>
      <p>ISSN [nach Vergabe durch die Deutsche Nationalbibliothek eintragen]</p>
    </div>
  </div>
</Basis>

---
import Basis from "../../../layouts/Basis.astro";
import ArtikelKopf from "../../../components/ArtikelKopf.astro";
import ScholarMeta from "../../../components/ScholarMeta.astro";
import Inhalt from "../../../components/Inhalt.astro";
import Zitiervorschlag from "../../../components/Zitiervorschlag.astro";
import PublicationCard from "../../../components/PublicationCard.astro";
import { ladeDaten } from "../../../lib/daten";
import { anker, datumLang, link, pdfGroesse } from "../../../lib/hilfen";
import type { Beitrag } from "../../../lib/typen";

export async function getStaticPaths() {
  const d = await ladeDaten();
  return d.beitraege.map((b) => ({ params: { slug: b.slug }, props: { b } }));
}
const { b } = Astro.props as { b: Beitrag };
const d = await ladeDaten();
// Das PDF wird nur auf großen Bildschirmen mit Maus eingebettet. Telefone öffnen es im eigenen Betrachter.
const pdf = b.pdf ? link(b.pdf) : "";
const groesse = pdfGroesse(b.pdf);
const pdfInfo = ["PDF", b.umfang_seiten && `${b.umfang_seiten} Seiten`, groesse].filter(Boolean).join(" · ");
const kapitel = (b.inhalt ?? []).filter((x) => x.typ === "h2").map((x) => (x as { text: string }).text);
const weitere = d.beitraege.filter((x) => x.slug !== b.slug)
  .sort((x, y) => Number(y.rubrik === b.rubrik) - Number(x.rubrik === b.rubrik)).slice(0, 3);
---
<Basis titel={b.titel} beschreibung={b.abstract_de} aktiv="publikationen/" typ="article" datum={b.datum}>
  <ScholarMeta slot="kopf" b={b} />
  <article class="seite beitrag">
    <nav class="pfad meta" aria-label="Pfad"><a href={link("publikationen/")}>Beiträge</a><span aria-hidden="true">/</span><span>{d.rubriken.get(b.rubrik)!.name}</span></nav>
    <div class="beitrag-raster">
      <div class="beitrag-haupt">
        <ArtikelKopf b={b} />
        <section class="abstract" aria-labelledby="abstract-titel">
          <h2 class="meta gold" id="abstract-titel">Abstract</h2>
          <p class="t-lead">{b.abstract_de}</p>
          {b.abstract_en && <><h2 class="meta gold">Abstract (English)</h2><p lang="en">{b.abstract_en}</p></>}
          <h2 class="meta gold">Schlagworte</h2>
          <ul class="schlagworte">{b.schlagworte.map((s) => <li>{s}</li>)}</ul>
        </section>
        <Inhalt bloecke={b.inhalt} />
        {b.literatur?.length ? (
          <section class="literatur"><h2 class="t-h2" id="literatur">Literatur</h2><ul>{b.literatur.map((x) => <li>{x}</li>)}</ul></section>
        ) : null}
        {b.versionen?.length ? (
          <section class="versionen"><h2 class="meta gold">Versionen</h2>
            <ul class="punktliste">{b.versionen.map((v) => <li>Version {v.version} vom {datumLang(v.datum)}. {v.hinweis}</li>)}</ul></section>
        ) : null}
        {pdf && (
          <section class="pdf-ansicht" id="lesen" aria-labelledby="pdf-titel">
            <h2 class="t-h2" id="pdf-titel">Den Beitrag lesen</h2>
            <object data-src={`${pdf}#view=FitH`} type="application/pdf" aria-label={`PDF ${b.titel}`} hidden></object>
            <div class="pdf-karte">
              <img class="nur-hell" src={link("logo/emblem.svg")} alt="" width="56" height="56" loading="lazy">
              <img class="nur-dunkel" src={link("logo/emblem-hell.svg")} alt="" width="56" height="56" loading="lazy">
              <div>
                <p class="pdf-karte-titel">{b.titel}</p>
                <p class="unterzeile">{pdfInfo} · {d.site.lizenz.name}</p>
              </div>
              <div class="knopf-zeile">
                <a class="knopf primaer" href={pdf} target="_blank" rel="noopener">PDF öffnen</a>
                <a class="knopf sekundaer" href={pdf} download>Herunterladen</a>
              </div>
            </div>
          </section>
        )}
        <Zitiervorschlag b={b} />
      </div>
      <aside class="beitrag-seite" aria-label="Zum Beitrag">
        <p class="meta gold">{d.formate.get(b.format)!.name} · {d.rubriken.get(b.rubrik)!.name}</p>
        {pdf && <a class="knopf primaer" href={pdf} download>PDF herunterladen</a>}
        <ul class="seite-links">
          {pdf && <li><a href="#lesen">Online lesen</a></li>}
          <li><a href="#zitieren">Zitieren</a></li>
          <li><a href={link(`beitraege/${b.slug}/zitat.bib`)} download>BibTeX</a> · <a href={link(`beitraege/${b.slug}/zitat.ris`)} download>RIS</a></li>
        </ul>
        {kapitel.length > 0 && (
          <nav aria-label="Inhalt des Beitrags">
            <p class="meta">Inhalt</p>
            <ul class="seite-links">
              <li><a href="#abstract-titel">Abstract</a></li>
              {kapitel.map((k) => <li><a href={`#${anker(k)}`}>{k}</a></li>)}
            </ul>
          </nav>
        )}
        <p class="unterzeile">Open Access · {d.site.lizenz.name}<br>{b.doi ? `DOI ${b.doi}` : "DOI beantragt"}</p>
      </aside>
    </div>
  </article>
  {weitere.length > 0 && (
    <section class="abschnitt seite" aria-labelledby="weitere">
      <div class="abschnitt-kopf"><h2 class="t-h2" id="weitere">Weitere Beiträge</h2><hr class="goldlinie"></div>
      <div class="raster">{weitere.map((x) => <PublicationCard b={x} kompakt />)}</div>
    </section>
  )}
</Basis>
<script>
  // PDF nur auf Desktop mit Maus einbetten, sonst bleibt die Karte mit den Knöpfen
  const obj = document.querySelector<HTMLObjectElement>(".pdf-ansicht object");
  if (obj && matchMedia("(min-width: 960px) and (hover: hover)").matches) {
    obj.data = obj.dataset.src!;
    obj.hidden = false;
    document.querySelector(".pdf-ansicht")?.classList.add("eingebettet");
  }
</script>

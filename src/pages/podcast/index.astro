---
import Basis from "../../layouts/Basis.astro";
import Seitenkopf from "../../components/Seitenkopf.astro";
import PublicationCard from "../../components/PublicationCard.astro";
import { ladeDaten } from "../../lib/daten";
import { link } from "../../lib/hilfen";
const d = await ladeDaten();
const folgen = d.beitraege.filter((b) => b.format === "gespraech");
---
<Basis titel="Gespräch" beschreibung="Podcast und Video. Die Autorinnen und Autoren von NUN im Gespräch über ihre Themen.">
  <div class="seite">
    <Seitenkopf titel="Gespräch" rubrik="Podcast und Video" einleitung="Die Autorinnen und Autoren im Gespräch über ihre Themen, zum Hören und zum Sehen." />
    {folgen.length ? <div class="raster">{folgen.map((b) => <PublicationCard b={b} />)}</div> : (
      <div class="panel schmal">
        <h2 class="t-h3">Die ersten Folgen sind in Vorbereitung</h2>
        <p>Hier erscheinen bald Gespräche als Podcast und Video. Bis dahin finden Sie alle Texte bei den Beiträgen.</p>
        <a class="textlink" href={link("publikationen/")}>Zu den Beiträgen</a>
      </div>
    )}
  </div>
</Basis>

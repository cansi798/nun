---
import { ladeDaten } from "../lib/daten";
import { link } from "../lib/hilfen";
const d = await ladeDaten();
const spalten = [
  { titel: "Inhalte", links: [["Publikationen", "publikationen/"], ["Ausgaben", "ausgaben/"], ["Abschlussarbeiten", "publikationen/?format=abschlussarbeit"], ["Podcast", "podcast/"]] },
  { titel: "NUN", links: [["Über uns", "ueber-uns/"], ["Autoren", "autoren/"], ["Open Access", "open-access/"], ["Interner Bereich", "intern/"]] },
];
---
<footer class="fuss">
  <div class="fuss-in">
    <hr class="goldlinie">
    <div class="fuss-oben">
      <img class="fuss-logo" src={link("logo/logo-quer-hell.svg")} alt="NUN, Damit wir einander kennen" width="240" height="88">
      <nav class="fuss-spalten" aria-label="Fußzeile">
        {spalten.map((s) => (
          <div>
            <h2 class="fuss-titel">{s.titel}</h2>
            <ul>{s.links.map(([t, p]) => <li><a href={link(p)}>{t}</a></li>)}</ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="fuss-unten">
      <span>Alle Beiträge frei zugänglich unter {d.site.lizenz.name} · ISSN {d.site.issn}</span>
      <span class="fuss-recht"><a href={link("impressum/")}>Impressum</a><a href={link("datenschutz/")}>Datenschutz</a><a href={link("ueber-uns/#kontakt")}>Kontakt</a></span>
    </div>
  </div>
</footer>

---
const { titel, einleitung, rubrik } = Astro.props as { titel: string; einleitung?: string; rubrik?: string };
---
<div class="seitenkopf">
  {rubrik && <div class="meta gold">{rubrik}</div>}
  <h1 class="t-h1">{titel}</h1>
  <hr class="goldlinie">
  {einleitung && <p class="t-lead einleitung">{einleitung}</p>}
  <slot />
</div>

---
// Filter nach Rubrik und Format, Auswahl in der Adresse (?rubrik=fiqh&format=artikel).
// Ohne JavaScript bleiben alle Beiträge sichtbar.
import { ladeDaten } from "../lib/daten";
const d = await ladeDaten();
// Nur Rubriken und Formate anbieten, zu denen es Beiträge gibt. Leere Knöpfe frustrieren.
const genutzt = (feld: "rubrik" | "format") => new Set(d.beitraege.map((b) => b[feld]));
const gruppen = [
  { name: "rubrik", label: "Rubrik", werte: d.site.rubriken.filter((r) => genutzt("rubrik").has(r.slug)).map((r) => [r.slug, r.name]) },
  { name: "format", label: "Form", werte: d.site.formate.filter((f) => genutzt("format").has(f.slug)).map((f) => [f.slug, f.name]) },
];
---
<div class="filter" data-filter>
  <label class="suche">
    <span class="sr">Suche nach Titel, Autor oder Schlagwort</span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <input type="search" name="q" placeholder="Titel, Autor oder Schlagwort" autocomplete="off" enterkeyhint="search">
  </label>
  {gruppen.map((g) => (
    <div class="filter-zeile" role="group" aria-label={g.label} data-gruppe={g.name}>
      <span class="meta filter-label" aria-hidden="true">{g.label}</span>
      <div class="filter-knoepfe">
        <button type="button" data-wert="" aria-pressed="true">Alle</button>
        {g.werte.map(([s, n]) => <button type="button" data-wert={s} aria-pressed="false">{n}</button>)}
      </div>
    </div>
  ))}
</div>
<script>
  const filter = document.querySelector<HTMLElement>("[data-filter]");
  if (filter) {
    const karten = [...document.querySelectorAll<HTMLElement>("[data-liste] .karte")];
    const suche = filter.querySelector<HTMLInputElement>("input[type=search]")!;
    const treffer = document.querySelector<HTMLElement>("[data-treffer]")!;
    const leer = document.querySelector<HTMLElement>("[data-leer]")!;
    const gruppen = [...filter.querySelectorAll<HTMLElement>("[data-gruppe]")];
    const auswahl = (g: HTMLElement) => [...g.querySelectorAll<HTMLButtonElement>('button[aria-pressed="true"]')]
      .map((b) => b.dataset.wert!).filter(Boolean);
    const setzen = (g: HTMLElement, werte: string[]) => g.querySelectorAll<HTMLButtonElement>("button").forEach((b) =>
      b.setAttribute("aria-pressed", String(b.dataset.wert ? werte.includes(b.dataset.wert) : werte.length === 0)));

    // Ein Beitrag passt, wenn Rubrik und Format gewählt sind (oder "Alle") und jedes Suchwort vorkommt.
    const passt = (k: HTMLElement, rubriken: string[], formate: string[], wort: string) =>
      (!rubriken.length || rubriken.includes(k.dataset.rubrik!)) &&
      (!formate.length || formate.includes(k.dataset.format!)) &&
      (!wort || wort.split(/\s+/).every((w) => k.dataset.suche!.includes(w)));

    const anwenden = (schreiben: boolean) => {
      const w: Record<string, string[]> = {};
      gruppen.forEach((g) => (w[g.dataset.gruppe!] = auswahl(g)));
      const wort = suche.value.trim().toLowerCase();
      let n = 0;
      karten.forEach((k) => { const z = passt(k, w.rubrik, w.format, wort); k.hidden = !z; if (z) n++; });
      treffer.textContent = n === 1 ? "1 Beitrag" : `${n} Beiträge`;
      leer.hidden = n > 0;
      if (schreiben) {
        const p = new URLSearchParams();
        if (w.rubrik.length) p.set("rubrik", w.rubrik.join(","));
        if (w.format.length) p.set("format", w.format.join(","));
        if (wort) p.set("q", wort);
        history.replaceState(null, "", location.pathname + (p.size ? `?${p}` : ""));
      }
    };
    const start = new URLSearchParams(location.search);
    gruppen.forEach((g) => {
      // Nur Werte übernehmen, für die es einen Knopf gibt, sonst bleibt "Alle" aktiv
      const da = new Set([...g.querySelectorAll<HTMLButtonElement>("button")].map((b) => b.dataset.wert));
      setzen(g, (start.get(g.dataset.gruppe!) || "").split(",").filter((w) => w && da.has(w)));
      g.addEventListener("click", (e) => {
        const b = (e.target as HTMLElement).closest("button");
        if (!b) return;
        let jetzt = auswahl(g);
        if (!b.dataset.wert) jetzt = [];
        else jetzt = jetzt.includes(b.dataset.wert) ? jetzt.filter((x) => x !== b.dataset.wert) : [...jetzt, b.dataset.wert];
        setzen(g, jetzt);
        anwenden(true);
      });
    });
    suche.value = start.get("q") || "";
    suche.addEventListener("input", () => anwenden(true));
    anwenden(false);
  }
</script>

---
// Google Scholar (citation_*) und Schema.org ScholarlyArticle aus denselben Daten.
import type { Beitrag } from "../lib/typen";
import { ladeDaten } from "../lib/daten";
import { absolut, autorName, beitragPfad, link, zitierUrl } from "../lib/hilfen";
const { b } = Astro.props as { b: Beitrag };
const d = await ladeDaten();
const autoren = b.autoren.map((s) => d.autoren.get(s)!);
const pdfUrl = b.pdf ? absolut(b.pdf) : "";
const m: [string, unknown][] = [["citation_title", b.titel]];
for (const a of autoren) m.push(["citation_author", `${a.nachname}, ${a.vorname}`]);
m.push(["citation_publication_date", b.datum.replaceAll("-", "/")], ["citation_journal_title", d.site.name],
  ["citation_language", "de"], ["citation_keywords", b.schlagworte.join("; ")],
  ["citation_abstract_html_url", absolut(beitragPfad(b))], ["DC.rights", d.site.lizenz.url]);
if (b.doi) m.push(["citation_doi", b.doi]);
if (pdfUrl) m.push(["citation_pdf_url", pdfUrl]);
const ausgabe = b.ausgabe ? d.ausgaben.get(b.ausgabe) : undefined;
if (ausgabe) {
  m.push(["citation_volume", ausgabe.jahrgang], ["citation_issue", ausgabe.heft], ["citation_issn", d.site.issn]);
  if (b.seiten?.length) m.push(["citation_firstpage", b.seiten[0]], ["citation_lastpage", b.seiten[1]]);
}
if (b.format === "abschlussarbeit")
  m.push(["citation_dissertation_institution", d.site.institut], ["citation_dissertation_name", "Bachelorarbeit"]);
const ld: Record<string, unknown> = {
  "@context": "https://schema.org", "@type": "ScholarlyArticle",
  headline: b.titel, alternativeHeadline: b.untertitel ?? "",
  author: autoren.map((a) => ({ "@type": "Person", name: autorName(a), ...(a.orcid ? { sameAs: `https://orcid.org/${a.orcid}` } : {}) })),
  datePublished: b.datum, inLanguage: "de", keywords: b.schlagworte, abstract: b.abstract_de,
  license: d.site.lizenz.url, isAccessibleForFree: true, identifier: zitierUrl(b),
  url: absolut(beitragPfad(b)), publisher: { "@type": "Organization", name: d.site.name },
  ...(pdfUrl ? { encoding: { "@type": "MediaObject", contentUrl: pdfUrl, encodingFormat: "application/pdf" } } : {}),
  ...(b.umfang_seiten ? { numberOfPages: b.umfang_seiten } : {}),
};
if (ausgabe) ld.isPartOf = { "@type": "PublicationIssue", issueNumber: ausgabe.heft,
  isPartOf: { "@type": "PublicationVolume", volumeNumber: ausgabe.jahrgang,
    isPartOf: { "@type": "Periodical", name: d.site.name, issn: d.site.issn } } };
const json = JSON.stringify(ld).replaceAll("</", "<\\/");
---
{m.map(([k, v]) => <meta name={k} content={String(v)} />)}
<link rel="license" href={d.site.lizenz.url} />
<link rel="alternate" type="application/x-bibtex" href={link(beitragPfad(b) + "zitat.bib")} />
<script type="application/ld+json" is:inline set:html={json} />

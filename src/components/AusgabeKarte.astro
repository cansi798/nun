---
import type { Ausgabe } from "../lib/typen";
import { beitraegeIn, ladeDaten } from "../lib/daten";
import { anzahl, link } from "../lib/hilfen";
const { a } = Astro.props as { a: Ausgabe };
const d = await ladeDaten();
const bs = beitraegeIn(d, a.id);
---
<article class="ausgabe-karte">
  <div class="heft-titel" aria-hidden="true">
    <img src={link("logo/logo-ohne-leitsatz-hell.svg")} alt="" width="747" height="875" loading="lazy">
    <span>Jahrgang {a.jahrgang} · Heft {a.heft}</span>
  </div>
  <div class="ausgabe-text">
    <div class="meta gold">Jahrgang {a.jahrgang} · Heft {a.heft} · {a.jahreszeit} {a.jahr}</div>
    <h2 class="t-h3">{a.titel}</h2>
    <p class="unterzeile">{bs.length ? anzahl(bs.length, "Beitrag", "Beiträge") : "In Vorbereitung"} · ISSN {d.site.issn}</p>
    {bs.length > 0 && <ul class="punktliste">{bs.slice(0, 3).map((b) => <li>{b.titel}</li>)}</ul>}
    <div class="link-zeile">
      <a class="textlink" href={link(`ausgaben/${a.id}/`)}>Inhaltsverzeichnis ansehen</a>
      {a.pdf && <a class="textlink" href={link(a.pdf)}>Gesamt-PDF herunterladen</a>}
    </div>
  </div>
</article>

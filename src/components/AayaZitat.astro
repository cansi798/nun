---
const { arabisch, uebersetzung, quelle } = Astro.props as { arabisch: string; uebersetzung: string; quelle: string };
---
<figure class="aaya">
  <p class="t-arabisch aaya-ar" dir="rtl" lang="ar">{arabisch}</p>
  <p class="aaya-de">{uebersetzung}</p>
  <figcaption class="meta gold">{quelle}</figcaption>
</figure>

---
// Untere Navigation auf dem Telefon, in Daumenreichweite. Ab 960px blendet sie sich aus.
import { link } from "../lib/hilfen";
const { aktiv = "" } = Astro.props as { aktiv?: string };
const start = Astro.url.pathname === import.meta.env.BASE_URL || Astro.url.pathname === import.meta.env.BASE_URL + "index.html";
const punkte = [
  { titel: "Start", pfad: "", an: start, icon: "M4 11 12 4l8 7v9h-5v-6H9v6H4Z" },
  { titel: "Beiträge", pfad: "publikationen/", an: aktiv === "publikationen/", icon: "M8 3h8l4 4v12H8Zm8 0v4h4M4 7v14h12" },
  { titel: "Formen", pfad: "formen/", an: aktiv === "formen/", icon: "", punkte: true },
  { titel: "Themen", pfad: "themen/", an: aktiv === "themen/", icon: "M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01" },
];
---
<nav class="mobil-nav" aria-label="Schnellnavigation">
  {punkte.map((p) => (
    <a href={link(p.pfad)} class:list={{ an: p.an }} aria-current={p.an ? "page" : undefined}>
      {/* Sechs Punkte für die sechs Formen, wie das Punktmotiv des Signets */}
      <svg viewBox="0 0 24 24" aria-hidden="true">{p.punkte
        ? [6, 12, 18].flatMap((y) => [8, 16].map((x) => <circle cx={x} cy={y} r="1.6" />))
        : <path d={p.icon} />}</svg>
      <span>{p.titel}</span>
    </a>
  ))}
  <button type="button" data-menue aria-controls="hauptnav" aria-expanded="false">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.2"/><circle cx="12" cy="12" r="1.2"/><circle cx="19" cy="12" r="1.2"/></svg>
    <span>Menü</span>
  </button>
</nav>

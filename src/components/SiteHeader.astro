---
// Wortmarke links, Navigation rechts (Handbuch, SiteHeader). Mobil ein Menü.
import { ladeDaten } from "../lib/daten";
import { link } from "../lib/hilfen";
const { aktiv = "" } = Astro.props as { aktiv?: string };
const d = await ladeDaten();
---
<header class="kopf">
  <div class="kopf-in">
    <a class="logo" href={link()} aria-label="NUN Startseite">
      <img class="nur-hell" src={link("logo/wortmarke.svg")} alt="NUN" width="128" height="72">
      <img class="nur-dunkel" src={link("logo/wortmarke-hell.svg")} alt="NUN" width="128" height="72">
    </a>
    <nav class="hauptnav" id="hauptnav" aria-label="Hauptnavigation">
      <p class="menue-titel meta">Alle Bereiche</p>
      {d.site.navigation.map((n) => (
        <a href={link(n.pfad)} class={n.pfad === aktiv ? "on" : undefined} aria-current={n.pfad === aktiv ? (Astro.url.pathname.endsWith(n.pfad) ? "page" : "true") : undefined}>{n.titel}</a>
      ))}
      <a class="nur-menue" href={link("podcast/")}>Gespräch</a>
      <a class="nur-menue" href={link("autoren/")}>Autoren</a>
      <a class="nur-menue" href={link("open-access/")}>Open Access</a>
      <button class="thema-knopf" type="button" data-thema-wechsel>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/></svg>
        <span class="thema-text">Dunkles Thema</span>
      </button>
    </nav>
  </div>
</header>
<script>
  const doc = document.documentElement;
  const knopfText = () => document.querySelectorAll<HTMLElement>(".thema-text").forEach((s) => {
    s.textContent = doc.dataset.theme === "dark" ? "Helles Thema" : "Dunkles Thema";
  });
  knopfText();
  document.querySelectorAll("[data-thema-wechsel]").forEach((k) => k.addEventListener("click", () => {
    const neu = doc.dataset.theme === "dark" ? "light" : "dark";
    doc.dataset.theme = neu;
    try { localStorage.setItem("nun-thema", neu); } catch {}
    document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((m) => (m.content = neu === "dark" ? "#1F2E4D" : "#F5EFE2"));
    knopfText();
  }));
  const knoepfe = [...document.querySelectorAll<HTMLButtonElement>("[data-menue]")];
  const menue = knoepfe[0];
  const nav = document.getElementById("hauptnav");
  const setze = (offen: boolean) => {
    nav?.classList.toggle("offen", offen);
    knoepfe.forEach((k) => k.setAttribute("aria-expanded", String(offen)));
    document.body.classList.toggle("menue-offen", offen);
    if (offen) nav?.querySelector<HTMLElement>("a")?.focus();
  };
  knoepfe.forEach((k) => k.addEventListener("click", () => setze(!nav?.classList.contains("offen"))));
  // Tippen außerhalb des Menüs schließt es
  document.addEventListener("click", (e) => {
    const z = e.target as HTMLElement;
    if (nav?.classList.contains("offen") && !nav.contains(z) && !z.closest("[data-menue]")) setze(false);
  });
  nav?.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest("a")) setze(false); });
  addEventListener("pageshow", () => setze(false));
  nav?.addEventListener("focusout", (e) => {
    const r = (e as FocusEvent).relatedTarget as HTMLElement | null;
    if (nav.classList.contains("offen") && r && !nav.contains(r) && !r.closest("[data-menue]")) setze(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && nav?.classList.contains("offen")) { setze(false); menue?.focus(); }
  });
  matchMedia("(min-width: 960px)").addEventListener("change", (m) => m.matches && setze(false));
</script>

---
import type { Beitrag } from "../lib/typen";
import { ladeDaten } from "../lib/daten";
const { b, lesezeit = true } = Astro.props as { b: Beitrag; lesezeit?: boolean };
const d = await ladeDaten();
const teile = [d.formate.get(b.format)!.name, d.rubriken.get(b.rubrik)!.name];
if (lesezeit && b.lesezeit) teile.push(`${b.lesezeit} Min Lesezeit`);
---
<div class="meta kennzeile">
  {teile.map((t, i) => <>{i > 0 && <span class="punkt" aria-hidden="true" />}<span>{t}</span></>)}
</div>

---
import type { Beitrag } from "../lib/typen";
import Kennzeile from "./Kennzeile.astro";
import { ladeDaten } from "../lib/daten";
import { ausgabeText, autorName, datumLang, link } from "../lib/hilfen";
const { b } = Astro.props as { b: Beitrag };
const d = await ladeDaten();
const ausgabe = b.ausgabe ? d.ausgaben.get(b.ausgabe) : undefined;
---
<header class="artikelkopf">
  {b.beispiel && <p class="hinweis meta">Beispielbeitrag zur Vorschau</p>}
  <Kennzeile b={b} lesezeit={false} />
  {b.reihe && <p class="reihe">{b.reihe}</p>}
  <h1 class="t-h1">{b.titel}</h1>
  {b.untertitel && <p class="untertitel">{b.untertitel}</p>}
  <hr class="goldlinie">
  {b.autoren.map((s) => d.autoren.get(s)!).map((a) => (
    <div class="autor">
      <a class="autor-name" href={link(`autoren/${a.slug}/`)}>{autorName(a)}</a>
      <small>{a.abschluss}, {d.site.institut}</small>
      {a.orcid && <a class="orcid" href={`https://orcid.org/${a.orcid}`}>ORCID {a.orcid}</a>}
    </div>
  ))}
  {b.betreuung && <p class="unterzeile">Betreuung {b.betreuung}</p>}
  <ul class="angaben meta">
    {ausgabe ? <li><a href={link(`ausgaben/${ausgabe.id}/`)}>{ausgabeText(ausgabe)}</a></li> : <li><time datetime={b.datum}>{datumLang(b.datum)}</time></li>}
    {ausgabe && b.seiten?.length ? <li>S. {b.seiten[0]}–{b.seiten[1]}</li> : null}
    {b.umfang_seiten ? <li>{b.umfang_seiten} Seiten</li> : null}
    {b.lesezeit ? <li>{b.lesezeit} Min Lesezeit</li> : null}
    <li>{b.doi ? <a href={`https://doi.org/${b.doi}`}>doi.org/{b.doi}</a> : "DOI beantragt"}</li>
    <li><a class="oa-plakette" href={link("open-access/")}>
      <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="7" width="10" height="7" rx="1"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0"/></svg>
      Open Access · {d.site.lizenz.name}</a></li>
  </ul>
  <div class="knopf-zeile kopf-knoepfe">
    {b.pdf && <a class="knopf primaer" href={link(b.pdf)} download>PDF herunterladen</a>}
    {b.pdf && <a class="knopf sekundaer" href="#lesen">Online lesen</a>}
    <a class="knopf sekundaer" href="#zitieren">Zitiervorschlag anzeigen</a>
  </div>
</header>

---
import { link } from "../lib/hilfen";
---
<div class="feld">
  <span class="feld-label" id="pdf-label">Beitrag als PDF</span>
  <label class="upload" data-upload>
    <input type="file" accept="application/pdf" name="pdf" aria-labelledby="pdf-label">
    <img class="nur-hell" src={link("logo/emblem.svg")} alt="" width="64" height="64">
    <img class="nur-dunkel" src={link("logo/emblem-hell.svg")} alt="" width="64" height="64">
    <span class="upload-text">PDF hierher ziehen <span>oder Datei auswählen</span></span>
    <span class="unterzeile">PDF, höchstens 50 MB</span>
  </label>
  <p class="upload-datei" data-upload-datei hidden></p>
</div>
